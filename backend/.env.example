# 复制为 backend/.env 后填写；该文件不要提交到仓库
# 字段名 = 环境变量名（大小写不敏感），完整说明见 backend/core/config.py

# ---------- 必填 ----------
# DeepSeek API Key：角色抽取与对话都用它，只保存在服务端
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- 强烈建议填写 ----------
# 会话签名密钥：留空则每次启动随机生成，重启后旧会话 token 失效，
# 并且「用户身份」会跟着变（相当于换了个人，历史对话接不上）。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# 允许访问后端的前端地址（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 模型 ----------
# DEEPSEEK_MODEL=deepseek-chat
# 角色抽取单独指定模型（留空 = 用 DEEPSEEK_MODEL）
# EXTRACTION_MODEL=deepseek-chat

# ---------- 存储 ----------
# 作品原文 / 角色库 / 对话记忆都在这里，默认 backend/data
# DATA_DIR=

# ---------- 上传与解析 ----------
# MAX_UPLOAD_BYTES=20971520     # 单文件 20MB
# MAX_BOOK_CHARS=2000000        # 正文最多 200 万字
# MIN_BOOK_CHARS=200            # 太短抽不出角色

# ---------- 角色抽取（决定 LLM 调用次数与花费）----------
# 抽取方式（重要）：
#   algo   = 纯算法挖掘，零 API 成本；性格是「平均 8 字/句、几乎不用感叹号」这类
#            可量化描述，没有语义概括和背景故事
#   hybrid = 算法挖出角色与台词，再用**一次**调用让模型补性格/背景（默认，性价比最高）
#   agent  = 算法 + 角色档案管理员 Agent（审核名单 / 联网对照 / 调阈值 / 抓头像）+ 补全
#   llm    = 逐块把原文丢给模型抽取，质量上限最高，成本也最高
# EXTRACTION_MODE=hybrid

# ---------- 角色档案管理员 Agent（EXTRACTION_MODE=agent 时生效）----------
# 最多走几步，每步一次模型调用 + 一个工具
# AGENT_MAX_STEPS=8
# 允许 agent 联网查书名对应的角色表（要求本机能出网）
# AGENT_ENABLE_WEB=true
# 允许 agent 爬取角色头像候选
# AGENT_ENABLE_AVATARS=true
# 单个角色最多保留几个头像候选
# AVATAR_MAX_CANDIDATES=6

# 算法模式下，一个名字至少出现几次才算角色（调高更保守）
# MINER_MIN_MENTIONS=3

# 以下仅 llm 模式生效：
# CHUNK_CHARS=6000              # 每块字数；超长小说会自动加大块长
# CHUNK_OVERLAP=400             # 相邻块重叠字数
# MAX_CHUNKS=40                 # 最多分多少块 = 最多调用多少次
# CHARACTERS_PER_CHUNK=6        # 每块最多抽几个角色
# MAX_CHARACTERS=20             # 每本书最多保留几个角色

# hybrid 模式给模型参考的样本量（越大越准，越贵）
# HYBRID_QUOTE_SAMPLES=6        # 每个角色带几句台词
# HYBRID_NARRATIVE_SAMPLES=2    # 每个角色带几段旁白
# HYBRID_REFERENCE_CHARS=2000   # 额外附带的原文参考量（用于补漏）
# HYBRID_BATCH_SIZE=10          # 每批补全几个角色（输出被截断时调小）

# ---------- 群聊说话规则 ----------
# 意愿分 = 0.30*外向 + 0.25*相关 + 0.15*情绪 + 噪声(±0.10)。
# 不 @ 时"相关"为 0，所以阈值别设太高，否则没人够线（0.55 就是死寂）。
# GROUP_SPEAK_THRESHOLD=0.30     # 过线才开口
# GROUP_ALL_THRESHOLD=0.18       # @全体成员 时降低门槛
# GROUP_ALWAYS_REPLY=true        # 没人过线也让意愿最高的人接一句
# GROUP_MAX_SPEAKERS=2           # 一轮最多几个人说话
# GROUP_MAX_ROUNDS=2             # 最多几轮（角色 @ 角色会开新轮）
# GROUP_COOLDOWN_SECONDS=45      # 刚说过的人冷却多久

# ---------- 说话样本（提示词里放多少原话）----------
# 角色"像不像本人"主要靠这个：把原著原话喂给模型，比堆性格形容词有效得多。
# PROMPT_QUOTE_LIMIT=12          # 最多放几条原话
# PROMPT_QUOTE_CHARS=700         # 这些原话的总字符预算（控 token）
# PROMPT_STYLE_MIN_SAMPLES=3     # 少于几条就不做风格统计

# ---------- 角色初始记忆（原文片段）----------
# EXCERPT_CHUNKS=3              # 每个角色带几段原文
# EXCERPT_CHARS=1200            # 每段截多长

# ---------- Agent ----------
# AGENT_CACHE_SIZE=8
# HISTORY_RUNS=8                # 带最近几轮对话

# ---------- 聊天 ----------
# MAX_PROMPT_CHARS=8000
# MAX_IMAGES=4
# MAX_IMAGE_BYTES=8388608
# MAX_TOTAL_IMAGE_BYTES=20971520

# ---------- 兼容旧前端（默认关闭）----------
# ALLOW_CLIENT_API_KEY=false

# ---------- 聊天图片 ----------
# 聊天里发的图会原图落盘（uploads/chat/），按天清理；0 = 永久保留
# CHAT_IMAGE_RETENTION_DAYS=30

# ---------- 对话判官（情绪/意图的 LLM 精判）----------
# off    = 只用规则（默认，零调用）
# auto   = 规则拿不准（否定、反问、两种意图都像）时才问一次模型
# always = 每轮都问（最准，但每轮多一次模型调用）
# DIALOGUE_JUDGE_MODE=auto
# DIALOGUE_JUDGE_MODEL=          # 留空复用 DEEPSEEK_MODEL
# DIALOGUE_JUDGE_TIMEOUT=6.0
